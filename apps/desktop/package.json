{
  "name": "@superbot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop control plane for persistent AI teammates",
  "author": "Super Bot Contributors",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fluentui/react-avatar": "^9.11.5",
    "@fluentui/react-badge": "^9.5.5",
    "@fluentui/react-button": "^9.11.0",
    "@fluentui/react-divider": "^9.7.4",
    "@fluentui/react-message-bar": "^9.7.5",
    "@fluentui/react-progress": "^9.5.4",
    "@fluentui/react-provider": "^9.22.20",
    "@fluentui/react-spinner": "^9.8.5",
    "@fluentui/react-textarea": "^9.7.6",
    "@fluentui/react-theme": "^9.2.2",
    "@fluentui/react-tooltip": "^9.10.5",
    "@phosphor-icons/react": "^2.1.10",
    "@superbot/contracts": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@fluentui/react-icons": "^2.0.316",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "org.superbot.desktop",
    "productName": "Super Bot",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Super-Bot-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Super Bot",
      "deleteAppDataOnUninstall": false
    }
  }
}
