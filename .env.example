# Copy to .env and replace every required value before starting Compose.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SUPERBOT_API_PORT=8420

# Optional external endpoints. Compose uses its internal Browser Gateway and
# Playwright Server by default; set these only for a non-Compose deployment.
SUPERBOT_BROWSER_GATEWAY_URL=http://127.0.0.1:8430
SUPERBOT_PLAYWRIGHT_WS_ENDPOINT=ws://127.0.0.1:3000/
# Clash/TUN Fake-IP users may explicitly trust its synthetic DNS range, for
# example 198.18.0.0/15. Leave empty unless your DNS proxy requires it.
SUPERBOT_BROWSER_TRUSTED_DNS_PROXY_CIDRS=

# Provider keys are optional. Configure only providers you intend to use.
SUPERBOT_DASHSCOPE_API_KEY=
SUPERBOT_DEEPSEEK_API_KEY=
SUPERBOT_MOONSHOT_API_KEY=
SUPERBOT_ZHIPU_API_KEY=
SUPERBOT_MINIMAX_API_KEY=
SUPERBOT_SILICONFLOW_API_KEY=
